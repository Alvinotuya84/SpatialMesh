{
  "expo": {
    "name": "SpatialMesh",
    "slug": "SpatialMesh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alvindo.SpatialMesh",
      "appleTeamId": "7QLC9H3L44"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow $(PRODUCT_NAME) to access your device motion"
        }
      ],
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "ios": {
            "cameraUsagePermission": "$(PRODUCT_NAME) uses your camera for AR experiences.",
            "microphoneUsagePermission": "$(PRODUCT_NAME) uses your microphone for AR experiences.",
            "photosPermission": "$(PRODUCT_NAME) would like to read photos for AR experiences.",
            "savephotosPermission": "$(PRODUCT_NAME) would like to save photos to your library during AR experiences."
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
